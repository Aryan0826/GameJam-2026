[node name="BodyLabel" type="Label3D" parent="CrawlViewportContainer/SubViewport/CrawlWorld/CrawlTilt/TextContent" unique_id=746538466]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.8, 0)
modulate = Color(1, 0.9, 0.12, 1)
outline_modulate = Color(0, 0, 0, 0.6)
text = "We are the crew of the HORIZON, exploring beyond the last human star charts. Our mission is simple: discover new worlds, make contact, and find a safe passage home.

As we approach each planet, its inhabitants detect our signal. An envoy appears on our flight screen: accept their challenge, or leave orbit in peace.

Win, and a new world welcomes us as ALLIES. Lose, and access is denied. We must withdraw, marked UNPROVEN until we earn their trust.

Captain Valeria and Navigator Sol stand ready. The first transmission is coming through..."
font = ExtResource("4_space_font")
outline_size = 4
vertical_alignment = 0
line_spacing = 16.0
autowrap_mode = 3
width = 820.0

