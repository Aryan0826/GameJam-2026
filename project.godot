; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Uncharted Wilds"
run/main_scene="res://scenes/home.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/flight/horizon.png"

[autoload]

Expedition="*res://scripts/core/expedition.gd"
Soundtrack="*res://scripts/core/soundtrack.gd"
PauseMenu="*res://scripts/ui/pause_menu.gd"

[display]

window/size/viewport_width=1320
window/size/viewport_height=850
window/size/window_width_override=1188
window/size/window_height_override=765
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://art/fonts/game_theme.tres"

[physics]

common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
